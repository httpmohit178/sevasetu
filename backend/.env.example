NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-local-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
DATA_FILE=./data/sevasetu.json
# Optional PostgreSQL. If absent, the backend uses the local JSON data file.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sevasetu
# In Render's free demo deployment, render.yaml enables visible demo OTPs.
# Do not use DEMO_OTP on a real service with real customer accounts.
# DEMO_OTP=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Production SMS OTP requires Twilio Verify:
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA...
